# Google Gemini API Keys (Put 1 or more comma-separated keys for auto-rotation)
# Format: key1,key2,key3,key4,key5
GEMINI_API_KEYS=key1,key2,key3,key4,key5

# GitHub Personal Access Token (for syncing/pushing updates)
GITHUB_TOKEN=your_github_token_here

# Default Quality (480p or 720p)
DEFAULT_QUALITY=720p

# Temporary and Output directories
OUTPUT_DIR=./output
TEMP_DIR=./temp
