# Google Gemini API Keys (Put 1 or more comma-separated keys for auto-rotation)
# Format: key1,key2,key3,key4,key5
GEMINI_API_KEYS=key1,key2,key3,key4,key5

# GitHub Personal Access Token (for syncing/pushing updates)
GITHUB_TOKEN=your_github_token_here

# Default Quality (480p or 720p)
DEFAULT_QUALITY=720p

# Temporary and Output directories
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Telegram Auto-Upload Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_SUBTITLE_CHAT_ID=-1004353971283
TELEGRAM_OWNER_ID=your_telegram_user_id
TELEGRAM_AUTO_UPLOAD=true
TELEGRAM_UPLOAD_SUBTITLE=true

# Optional: TMDB API Key (falls back automatically to AniList keyless API)
TMDB_API_KEY=

# Telegram Caption Style: "style2" (Compact dashed) or "style1" (Boxed with genres)
TELEGRAM_CAPTION_STYLE=style2
